# ============================================================
# WhatsApp AI Bot — Configurações de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Banco de Dados
DB_HOST=localhost
DB_NAME=whatsapp_bot
DB_USER=root
DB_PASS=

# Número do bot (com DDI, sem + e sem espaços)
# Ex: 5511999999999
BOT_PHONE=

# Porta do servidor PHP (para desenvolvimento local)
APP_PORT=8080

# Ambiente
NODE_ENV=production
